/* ============================================================
   1. MOBILE NAV TOGGLE  (querySelector + addEventListener)
   ============================================================ */
const navToggle = document.querySelector('#nav-toggle');
const primaryNav = document.querySelector('#primary-nav');

if (navToggle && primaryNav) {
  const closeNav = () => {
    navToggle.setAttribute('aria-expanded', 'false');
    navToggle.setAttribute('aria-label', 'Open navigation menu');
    primaryNav.classList.remove('is-open');
  };

  const openNav = () => {
    navToggle.setAttribute('aria-expanded', 'true');
    navToggle.setAttribute('aria-label', 'Close navigation menu');
    primaryNav.classList.add('is-open');
  };

  navToggle.addEventListener('click', () => {
    const expanded = navToggle.getAttribute('aria-expanded') === 'true';
    expanded ? closeNav() : openNav();
  });

  // Escape closes the menu and returns focus to the toggle
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && navToggle.getAttribute('aria-expanded') === 'true') {
      closeNav();
      navToggle.focus();
    }
  });

  // Click outside closes it (mobile convenience)
  document.addEventListener('click', (e) => {
    if (navToggle.getAttribute('aria-expanded') !== 'true') return;
    if (!primaryNav.contains(e.target) && !navToggle.contains(e.target)) {
      closeNav();
    }
  });
}

/* ============================================================
   2. FORM VALIDATION  (accessible, no alert())
   ============================================================ */
const form = document.querySelector('#contact-form');

if (form) {
  const fields = ['name', 'email', 'subject', 'message'];
  const status = form.querySelector('#form-status');
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const getInput = (name) => form.elements[name];
  const getError = (name) => document.getElementById(`${name}-error`);

  function setError(name, message) {
    const input = getInput(name);
    const error = getError(name);
    error.textContent = message;
    error.hidden = false;
    input.setAttribute('aria-invalid', 'true');
  }

  function clearError(name) {
    const input = getInput(name);
    const error = getError(name);
    if (error.hidden) return;
    error.textContent = '';
    error.hidden = true;
    input.removeAttribute('aria-invalid');
  }

  function validateField(name) {
    const value = getInput(name).value.trim();

    if (!value) {
      setError(name, 'This field is required.');
      return false;
    }
    if (name === 'email' && !emailPattern.test(value)) {
      setError(name, 'Please enter a valid email address (e.g. you@example.com).');
      return false;
    }
    clearError(name);
    return true;
  }

  // Live character counter
  const message = getInput('message');
  const counter = document.getElementById('message-count');
  message.addEventListener('input', () => {
    counter.textContent = `${message.value.length} / 500`;
  });

  // Clear errors as soon as the user fixes a field
  fields.forEach((name) => {
    const input = getInput(name);
    input.addEventListener('input',  () => clearError(name));
    input.addEventListener('change', () => clearError(name));
    input.addEventListener('blur', () => {
      if (input.value.trim()) validateField(name);
    });
  });

  // Submit handler
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let firstInvalid = null;

    fields.forEach((name) => {
      const ok = validateField(name);
      if (!ok && !firstInvalid) firstInvalid = getInput(name);
    });

    if (firstInvalid) {
      status.className = 'error';
      status.textContent = 'Please fix the highlighted fields and try again.';
      firstInvalid.focus();
      return;
    }

    status.className = 'success';
    status.textContent = 'Thanks! Your message has been sent.';
    form.reset();
    counter.textContent = '0 / 500';
  });
}

/* ============================================================
   3. BONUS: GITHUB PROFILE CARD  (fetch + error handling)
   ============================================================ */
async function loadGitHubCard() {
  const container = document.getElementById('github-content');
  if (!container) return;

  try {
    const res = await fetch('https://api.github.com/users/ROBELG1999', {
      headers: { Accept: 'application/vnd.github+json' },
    });
    if (!res.ok) throw new Error(`GitHub API responded ${res.status}`);

    const user = await res.json();

    container.innerHTML = `
      <img src="${user.avatar_url}" alt="" width="72" height="72" loading="lazy">
      <div>
        <p><strong>
          <a href="${user.html_url}" rel="noopener" target="_blank">@${user.login}</a>
        </strong></p>
        <p>${user.public_repos} public repos &middot; ${user.followers} followers</p>
        ${user.bio ? `<p>${user.bio}</p>` : ''}
      </div>`;
  } catch (err) {
    container.innerHTML = `
      <p class="error">
        Couldn't load GitHub data right now.
        <a href="https://github.com/ROBELG1999" rel="noopener" target="_blank">
          View the profile directly on GitHub &nearr;
        </a>
      </p>`;
    console.error('GitHub fetch failed:', err);
  }
}

loadGitHubCard();
